# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# n8n Webhook URL for vendor onboarding
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n-latest-4dbq.onrender.com/webhook/vendor-onboard

# Site URL
NEXT_PUBLIC_SITE_URL=https://beeline.works

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC=pk_test_your_public_key_here
PAYSTACK_SECRET=sk_test_your_secret_key_here

# Paystack Webhook Secret (for verifying webhook signatures)
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# Paystack Plan Codes (create these in Paystack dashboard)
PAYSTACK_PLAN_PERSONAL=personal-monthly
PAYSTACK_PLAN_BUSINESS=business-monthly
PAYSTACK_PLAN_ENTERPRISE_5=enterprise-5
PAYSTACK_PLAN_ENTERPRISE_12=enterprise-12
PAYSTACK_PLAN_ENTERPRISE_25=enterprise-25
PAYSTACK_PLAN_ENTERPRISE_60=enterprise-60

# Cloud Bridge URL (WhatsApp Gateway Service)
# Local development: http://localhost:3000
# Production: https://beeline-bridge.onrender.com
CLOUD_BRIDGE_URL=http://localhost:3000
