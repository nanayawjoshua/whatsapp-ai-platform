# ============================================================================
# BEELINE BUZZ - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your values
# Never commit .env with real secrets!

# ============================================================================
# PHONE BRIDGE (Essential)
# ============================================================================

PORT=3001
PHONE_MODEL=TCL_50SE
NODE_ENV=production

# ============================================================================
# SUPABASE (Replaces Render PostgreSQL + Redis)
# ============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ============================================================================
# GROQ API (Replaces Claude)
# ============================================================================
# Get free API key from: https://console.groq.com/keys

GROQ_API_KEY=your-groq-api-key-here

# ============================================================================
# PAWAPAY (For instant settlements - Week 3)
# ============================================================================

PAWAPAY_URL=https://api.pawapay.cloud
PAWAPAY_API_KEY=your-pawapay-key-here

# ============================================================================
# WEBSITE/NEXT.JS (Vercel)
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
PHONE_BRIDGE_URL=http://localhost:3001

# For production:
# PHONE_BRIDGE_URL=https://your-phone-bridge-ngrok-url.ngrok.io

# ============================================================================
# N8N WORKFLOW (Jiji lead generation - Week 2)
# ============================================================================

N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# ============================================================================
# OPTIONAL: Development Tools
# ============================================================================

LOG_LEVEL=info
DEBUG=false

# ============================================================================
# REMOVED (No longer needed)
# ============================================================================
# UPSTASH_REDIS_URL - DELETED
# RENDER_EXTERNAL_URL - DELETED
# BRIDGE_ID - DELETED
# BRIDGE_LOCATION - DELETED
# BRIDGE_REGISTRY_KEY - DELETED
# NODE_TYPE - DELETED
# NODE_ID - DELETED
# BATTERY_MONITOR - DELETED
# IP_ROTATION - DELETED
