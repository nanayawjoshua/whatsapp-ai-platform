# n8n Configuration
# Copy this file to .env and update with your actual values

# n8n Authentication (CHANGE THESE!)
N8N_USER=admin
N8N_PASSWORD=change_this_secure_password_123

# Webhook Configuration
# For local development, use localhost
# For production, use your actual domain or ngrok/cloudflare tunnel URL
WEBHOOK_URL=http://localhost:5678
N8N_HOST=localhost

# LLM API Keys (Add your API keys here)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=../backend/whatsapp-session

# Optional: PostgreSQL (for production scaling)
# POSTGRES_USER=n8n
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_DB=n8n

# Notes:
# - Keep .env file secure and NEVER commit to Git
# - Use strong passwords for production
# - Update WEBHOOK_URL when using ngrok/cloudflare tunnel for external access
# - Get Groq API key from: https://console.groq.com
# - Get OpenAI API key from: https://platform.openai.com
# - Get Anthropic API key from: https://console.anthropic.com
