# Beeline Pi Bridge Configuration

# Cloud n8n webhook URL (Linode)
N8N_WEBHOOK_URL=http://172.237.109.60/webhook/whatsapp

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Max vendors per Pi (recommended: 50)
MAX_VENDORS=50

# Session storage path
SESSIONS_PATH=./sessions

# Auto-reconnect on disconnect
AUTO_RECONNECT=true

# Reconnect delay in ms
RECONNECT_DELAY=5000
