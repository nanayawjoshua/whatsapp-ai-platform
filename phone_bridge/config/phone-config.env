# Beeline Phone Bridge Configuration
# PROJECT OS - Phase 1: Phone-Specific Environment
# Target: TCL 50SE (Addon Node) - Helio G88, 6-12GB RAM, 5010mAh battery
# Purpose: Residential IP bridge with mobile SIM rotation

# Database (same as cloud)
DATABASE_URL=your-postgresql-url-here

# Redis (for sync with Pi master)
REDIS_URL=your-redis-url-here

# n8n Webhook (for AI processing)
N8N_WEBHOOK_URL=https://n8n-latest-4dbq.onrender.com/webhook/beeline-in

# Phone-Specific Configuration
NODE_TYPE=addon  # 'primary' for Pi, 'addon' for phones
PHONE_MODEL=TCL_50SE
CPU_CORES=8  # Helio G88 octa-core
MAX_SESSIONS=75  # Conservative for phone
WORKER_THREADS=4  # 4 threads for parallelism

# Battery & Performance Optimization
BATTERY_MONITOR=true
LOW_BATTERY_THRESHOLD=20  # Pause at 20% battery
HIGH_LOAD_THRESHOLD=80  # Throttle at 80% CPU

# IP Management (Mobile SIM)
IP_ROTATION=true
SIM_DATA_PRIORITY=true  # Prefer mobile data over Wi-Fi
ROTATION_INTERVAL=100  # Rotate IP every 100 sessions

# Sync Configuration
REDIS_SYNC_INTERVAL=30  # Sync with Pi every 30 seconds
MASTER_NODE=pi-ghana  # Pi as master for state sync

# Logging (phone-optimized)
LOG_LEVEL=info
LOG_FILE=/data/data/com.termux/files/home/beeline/phone-bridge.log

# Health Monitoring
HEALTH_CHECK_PORT=3001  # Different from main bridge
TELEGRAM_ALERTS=true
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Performance Tuning for Phone
MEMORY_LIMIT=512MB  # Conservative memory usage
CONNECTION_TIMEOUT=30  # Shorter timeouts for mobile
RECONNECT_DELAY=5000  # Faster reconnection

# Local AI (PROJECT OS - Phase 3: Future enhancement)
LOCAL_AI_ENABLED=false  # Enable when ML Kit integrated
MODEL_PATH=/data/data/com.termux/files/home/models/phi-3.5-mini

# Emergency Fallback
FALLBACK_TO_CLOUD=true  # If phone fails, route to cloud bridge
CLOUD_BRIDGE_URL=https://beeline-bridge.onrender.com