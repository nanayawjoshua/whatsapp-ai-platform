# Beeline Phone Bridge Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# GROQ API (AI Message Classification)
# ============================================================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ============================================================================
# CLOUDFLARE TUNNEL CONFIGURATION (for IP monitoring)
# ============================================================================
# Required for automatic IP update script
# Get these from: https://dash.cloudflare.com/

# Your Cloudflare API Token (with Cloudflare Tunnel permissions)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Account.Cloudflare Tunnel:Edit
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# Your Cloudflare Account ID
# Find at: https://dash.cloudflare.com/ (bottom right of any page)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port for the phone bridge server
PORT=3001

# Phone model (for logging/debugging)
PHONE_MODEL=TCL_50SE

# Node environment
NODE_ENV=production

# ============================================================================
# OPTIONAL: WEBHOOK CONFIGURATION
# ============================================================================
# If you want to receive notifications about IP changes
# WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# ============================================================================
# NOTES
# ============================================================================
# - Never commit this file with real credentials to git
# - The .env file is ignored by git (see .gitignore)
# - Each phone in your fleet needs its own .env file
# - Keep your API tokens secure and rotate them regularly
